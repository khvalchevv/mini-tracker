# Copy to `.env` and fill in. NEVER commit the real file — .gitignore
# covers it, and this repo is public.
#
# Secrets do not travel through git. Move `.env`, `api_keys.json` and
# `proxies.txt` to a new machine by hand (USB, password manager, scp).

# ── Telegram ──────────────────────────────────────────────────────────
TG_BOT_TOKEN=
TG_ALLOWED_USERS=

# ── Wallets (the hot wallet holds real funds — treat like cash) ───────
DEX_PRIVATE_KEY=
SOLANA_PRIVATE_KEY=

# ── Data providers ────────────────────────────────────────────────────
ALCHEMY_KEY=
HUB_KEY=
HUB_BASE=https://hub.arbitron.dev

# ── Proxies (host:port:user:pass) ─────────────────────────────────────
# Private, IP-whitelisted proxies for exchange private endpoints.
PRIVATE_PROXY=
PRIVATE_PROXY_BINANCE=

# ── Scanning ──────────────────────────────────────────────────────────
POLL_INTERVAL_SEC=2
ALERT_COOLDOWN_SEC=1800
SPREAD_GROW_PCT=0.3
DS_TIMEOUT=6
HUNT_CYCLE_SEC=1
HUNT_COOLDOWN_SEC=1800
HUNT_FETCH_TIMEOUT=3
HUNT_DEX_ENABLED=true
HUNT_DEX_CYCLE_SEC=5

# ── Execution limits ──────────────────────────────────────────────────
KYBER_ENABLED=true
DEX_MAX_TX_USD=5000
DEX_MAX_USD_PER_HOUR=1000000
KYBER_QUOTE_USD=5000
AUTOEXEC_DEX_MAX_USD=5000
AUTOEXEC_MIN_PROFIT_USD=20
MIN_PROFIT_USD=20

# Cooldown after a venue refuses a withdrawal (Bitvavo errorCode 434 and
# friends) before the bot opens another position needing that withdrawal.
# A position already held always still attempts its withdrawal.
WD_BLOCK_COOLDOWN_SEC=3600

# ── RPC ───────────────────────────────────────────────────────────────
PREFER_PUBLIC_RPC=0
USE_HUB_RPC=0
DEX_RPC_BASE=https://mainnet.base.org

# ── Rebalance targets ─────────────────────────────────────────────────
AUTO_REBAL_TRIGGER_USD=1000
AUTO_REBAL_TARGET_USD=2000
TARGET_GATE_USDT=2000.0
TARGET_BITVAVO_USDC=2000.0
TARGET_BINANCE_USDT=2000.0
AUTO_REBAL_HW_ETH_USDC_TARGET=1000
AUTO_REBAL_HW_ETH_USDC_TRIGGER=500
AUTO_REBAL_HW_BASE_USDC_TARGET=1000
AUTO_REBAL_HW_BASE_USDC_TRIGGER=500

# ── Bitvavo buy leg ───────────────────────────────────────────────────
BV_BUY_LIMIT_WAIT_SEC=300
BV_BUY_POLL_SEC=15
BV_BUY_MIN_FILL_USD=50
BV_BUY_LIMIT_BUFFER_BPS=10
BV_BOOK_TOL_TIGHT=0.15

# ── Blacklist a token after a losing run ──────────────────────────────
BLACKLIST_LOSS_HOURS=1.0
BLACKLIST_MIN_LOSS_USD=-5.0

# ── Tracking: freshness ───────────────────────────────────────────────
# Staleness is decided by AGE, never by how far two prices disagree.
# Both legs of a cross must be younger than this (REST refills quiet
# Bitvavo pairs every REST_SNAPSHOT_SEC, so leave one missed snapshot
# of slack).
HUNT_MAX_QUOTE_AGE_SEC=45
WS_MAX_AGE_SEC=45
REST_SNAPSHOT_SEC=30

# ── Tracking: validation workers ──────────────────────────────────────
# Scanning never waits on validation. `_cycle` enqueues candidates; this
# many workers size/quote/send them. A validated candidate that did not
# fire is left alone for HUNT_EVAL_TTL_SEC unless its spread grows by
# SPREAD_GROW_PCT.
HUNT_VALIDATE_WORKERS=4
HUNT_EVAL_TTL_SEC=45

# ── Tracking: DEX candidates ──────────────────────────────────────────
# DS/OKX spot only SCREENS. A DEX entry becomes a candidate only with a
# fresh two-sided Kyber quote. Per DEX cycle the top KYBER_SCREEN_MAX
# bases by spot gap are quoted at KYBER_SCREEN_USD; a base is not
# re-quoted for KYBER_SCREEN_COOLDOWN_SEC unless Bitvavo moved by
# KYBER_SCREEN_MOVE_PCT. The quote counts as fresh for KYBER_FRESH_SEC.
KYBER_SCREEN_USD=500
KYBER_SCREEN_MAX=25
KYBER_SCREEN_COOLDOWN_SEC=60
KYBER_SCREEN_MOVE_PCT=0.2
KYBER_FRESH_SEC=90
KYBER_CONCURRENCY=8

# Per-token dep/wd network refresh at alert time, at most once per base
# per this many seconds (Bitvavo's is a full /assets reload: once/min).
NETWORK_REFRESH_BASE_SEC=300

# Hourly: pick up new Bitvavo listings, refresh the CoinGecko exchange
# map, resubscribe the sockets.
IDENTITY_REFRESH_SEC=3600

# ── OKX Web3 hub ──────────────────────────────────────────────────────
# The hub throttles concurrency. Measured on a cold cache: 2 is 27%
# faster with no lost responses, 3 starts dropping them, 6 is rejected.
OKX_HUB_CONCURRENCY=2
OKX_BATCH_PER_CYCLE=40

# ── Reconciler ────────────────────────────────────────────────────────
RECONCILE_INTERVAL_SEC=900
RECONCILE_MIN_USD=5

# ── Gas refill (buys native gas on Gate, withdraws to the hot wallet) ─
GATE_MIN_ORDER_USD=3.0
GAS_BASEFEE_MULT=1.5

# ── Gas cost model in the DEX ladder ──────────────────────────────────
# Native asset prices come live from the hunter's Bitvavo feed; these
# are the gas-unit assumptions per leg.
SWAP_GAS_UNITS=300000
TRANSFER_GAS_UNITS=65000
GAS_COST_TTL_SEC=120
